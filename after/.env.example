# 数据库配置
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=<set-database-url>

# Neo4j 配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<set-a-local-password>
FAMILYTREE_ADMIN_PASSWORD=<set-admin-password>
FAMILYTREE_TEST_PASSWORD=<set-test-password>

# 应用配置
APP_NAME=族谱查询系统
DEBUG=True

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 邮件配置（可选）
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_SENDER_EMAIL=<sender-email>
SMTP_SENDER_PASSWORD=<mail-app-password>
SMTP_ADMIN_EMAIL=<admin-email>
