# PostgreSQL 18：与 deploy/.env 中的 POSTGRES_PASSWORD 保持一致。
# 分项配置由 SQLAlchemy 组装连接地址，密码无需自行做 URL 转义。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=familytree
POSTGRES_USER=
POSTGRES_PASSWORD=

# 本地账号凭据；初始化演示数据时需要同时设置管理员和测试用户密码。
# 密码读取优先级：显式进程环境变量 > 本文件 > 根目录未跟踪的账密.txt。
# 显式留空会阻止初始化；仅使用账密文件时，请移除本文件对应的 PASSWORD 行。
FAMILYTREE_ADMIN_USERNAME=
FAMILYTREE_ADMIN_PASSWORD=
FAMILYTREE_ADMIN_EMAIL=
FAMILYTREE_TEST_USERNAME=
FAMILYTREE_TEST_PASSWORD=
FAMILYTREE_TEST_EMAIL=

# 应用配置
APP_NAME=族谱查询系统
DEBUG=True

# 服务器配置
HOST=127.0.0.1
PORT=8000
SERVER_URL=http://localhost:8000

# 邮件配置（可选）
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
SMTP_ADMIN_EMAIL=
