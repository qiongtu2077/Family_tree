# 复制为 deploy/.env 后填写；账号、密码和邮件地址均不预填。
# 使用随附 Compose 新建数据库时，POSTGRES_USER 填 familytree。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=familytree
POSTGRES_USER=
POSTGRES_PASSWORD=

FAMILYTREE_ADMIN_USERNAME=
FAMILYTREE_ADMIN_PASSWORD=
FAMILYTREE_ADMIN_EMAIL=
FAMILYTREE_TEST_USERNAME=
FAMILYTREE_TEST_PASSWORD=
FAMILYTREE_TEST_EMAIL=

SERVER_URL=http://localhost:8080
AUTH_ENABLED=True
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
SMTP_ADMIN_EMAIL=
